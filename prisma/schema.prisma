// Modelo de dados do Hub RPG.
// A lógica por trás de cada escolha está em docs/ARQUITETURA.md.
//
// Reescrito em 27/08/2026 pela virada de escopo (decisões #35 e #36): o Hub
// é sobre FICHAS DE PERSONAGEM nos sistemas do Zé. O cadastro de lore —
// universos, entidades, campos e vínculos — saiu do projeto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // A partir do Prisma 7 os endereços de conexão não moram mais aqui:
  // ficam em prisma.config.ts, fora do alcance deste arquivo.
}

// ---------------------------------------------------------------------------
// Listas fixas
// ---------------------------------------------------------------------------

/// Quem uma pessoa é dentro de uma campanha específica.
/// A mesma pessoa pode ser mestre numa mesa e jogadora em outra.
enum Papel {
  MESTRE
  JOGADOR
}

/// A trava do projeto (decisão #13): tudo marcado como MESTRE nunca sai do
/// servidor para quem não é mestre daquela campanha. Hoje vale para as notas
/// de sessão; volta a valer para campos de ficha quando eles existirem.
enum Visibilidade {
  PUBLICO
  MESTRE
}

enum SituacaoCampanha {
  PLANEJADA
  ATIVA
  PAUSADA
  ENCERRADA
}

/// Estado organizacional do personagem dentro do Hub — não mexe em nada
/// dentro da ficha (PV, condições, etc.), é só pra separar "quem eu ainda
/// jogo" de "quem ficou pra trás" nas listas (decisão #134).
enum StatusPersonagem {
  ATIVO
  RESERVA
  APOSENTADO
  MORTO
  ARQUIVADO
}

/// Confirmação de presença numa sessão (decisão #135).
enum RespostaPresenca {
  VOU
  TALVEZ
  NAO_VOU
}

/// De onde veio a notificação (decisão #136) — só pra escolher o ícone/rótulo
/// na tela; o texto de verdade já vem pronto no campo `texto` de `Notificacao`.
enum TipoNotificacao {
  SESSAO_MARCADA
  AVISO_NOVO
  ENQUETE_NOVA
}

// ---------------------------------------------------------------------------
// Identidade
// ---------------------------------------------------------------------------

/// Espelho do usuário autenticado. O id é o mesmo que o serviço de login
/// atribui, para não existirem duas identidades da mesma pessoa.
model Usuario {
  id                String   @id @db.Uuid
  email             String   @unique
  nome              String?
  avatarUrl         String?
  criadoEm          DateTime @default(now())
  /// Chaves de `SISTEMAS` (src/lib/sistemas.ts) marcadas como favoritas por
  /// esta pessoa — decisão #134. Fica na conta, não no navegador, porque a
  /// mesma pessoa abre o Hub de mais de um aparelho.
  sistemasFavoritos String[] @default([])

  participacoes   Participacao[]
  personagens     Personagem[]
  sessaoPresencas SessaoPresenca[]
  mensagensChat   MensagemChat[]
  avisos          Aviso[]
  enquetes        Enquete[]
  enqueteVotos    EnqueteVoto[]
  notificacoes    Notificacao[]
  itens           Item[]

  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Sistemas e mesas
// ---------------------------------------------------------------------------

/// Um conjunto de regras: Fabula Ultima, Kaizoku no Sho, o homebrew de SAO,
/// Thrylikí Chelóna. O registro aqui é só o cadastro; as regras de verdade
/// vivem num módulo de código próprio (decisão #17).
model Sistema {
  id        String  @id @default(uuid()) @db.Uuid
  chave     String  @unique
  nome      String
  descricao String?
  ativo     Boolean @default(true)

  campanhas   Campanha[]
  personagens Personagem[]

  @@map("sistemas")
}

/// Uma mesa. Aponta para um sistema e tem um mestre e vários jogadores.
model Campanha {
  id              String           @id @default(uuid()) @db.Uuid
  nome            String
  slug            String           @unique
  sistemaId       String           @db.Uuid
  situacao        SituacaoCampanha @default(PLANEJADA)
  criadoEm        DateTime         @default(now())
  /// Anotações livres do mestre — plano de sessão, NPCs, segredos do enredo.
  /// Nunca sai do servidor para quem não é mestre desta campanha (decisão
  /// #13): a rota que a lê nem chega a fazer a consulta se quem pergunta
  /// não for mestre.
  manualMestre    String?
  /// Identidade da campanha (decisão #134) — capa/descrição/tags são só
  /// exibição, públicas pra quem já vê a campanha (mestre e jogadores
  /// ligados); não guardam nada sensível, por isso não passam pela mesma
  /// trava do `manualMestre`.
  capaUrl         String?
  descricao       String?
  tags            String[]         @default([])
  /// Código curto de convite (decisão #138) — mesma coisa que o link de
  /// convite (o próprio `id` da campanha), só mais fácil de falar em voz
  /// alta ou digitar numa tela pequena. Não é mais nem menos secreto que o
  /// link: quem tem o código consegue exatamente o que quem tem o link
  /// consegue (decisão #46 tratava o link como "qualquer um com o link do
  /// Google Docs" — isto aqui é a mesma porta, só com uma chave mais curta).
  codigoConvite   String           @unique
  /// Espelho da ordem de iniciativa da Mesa ao Vivo (decisão #137) — o
  /// mestre continua controlando tudo do próprio navegador (localStorage,
  /// decisão #46); isto aqui só existe pra jogador conseguir ver a mesma
  /// ordem em modo leitura. Formato livre (`{combatentes, vezDe, rodada}`),
  /// null enquanto o mestre nunca abriu a Mesa ao Vivo desta campanha.
  iniciativaAtual Json?

  sistema              Sistema              @relation(fields: [sistemaId], references: [id], onDelete: Restrict)
  participacoes        Participacao[]
  personagens          Personagem[]
  sessoes              Sessao[]
  mensagensChat        MensagemChat[]
  avisos               Aviso[]
  enquetes             Enquete[]
  notificacoes         Notificacao[]
  camposPersonalizados CampoPersonalizado[]
  conquistas           Conquista[]
  grupos               Grupo[]
  itens                Item[]
  veiculos             Veiculo[]

  @@index([sistemaId])
  @@map("campanhas")
}

/// Liga uma pessoa a uma campanha, dizendo se ela é mestre ou jogadora.
model Participacao {
  id         String   @id @default(uuid()) @db.Uuid
  campanhaId String   @db.Uuid
  usuarioId  String   @db.Uuid
  papel      Papel    @default(JOGADOR)
  criadoEm   DateTime @default(now())

  campanha Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([campanhaId, usuarioId])
  @@index([usuarioId])
  @@map("participacoes")
}

// ---------------------------------------------------------------------------
// Fichas
// ---------------------------------------------------------------------------

/// A ficha de personagem.
///
/// `dados` guarda a ficha inteira em JSON, no formato que o módulo daquele
/// sistema entende. É de propósito: cada sistema tem campos completamente
/// diferentes, e uma tabela com colunas fixas ou obrigaria a coluna nova a
/// cada sistema, ou viraria uma sopa de campos vazios. Quem valida o
/// conteúdo é o módulo do sistema, não o banco.
///
/// `campanhaId` é opcional: dá para ter uma ficha avulsa, fora de mesa
/// nenhuma — que é como quase toda ficha nasce.
model Personagem {
  id            String           @id @default(uuid()) @db.Uuid
  sistemaId     String           @db.Uuid
  donoId        String           @db.Uuid
  campanhaId    String?          @db.Uuid
  nome          String
  dados         Json             @default("{}")
  /// Versão do formato de `dados`, para migrar fichas antigas quando o
  /// módulo do sistema mudar de estrutura.
  versaoFicha   Int              @default(1)
  /// Link de leitura: com isto ligado, qualquer pessoa com a URL da ficha
  /// (dono ou não, logada ou não) consegue ABRIR em modo leitura — o id da
  /// ficha, um UUID, é o segredo do link, como em "qualquer um com o link"
  /// do Google Docs. Nunca dá direito de editar: só o dono salva.
  compartilhado Boolean          @default(false)
  /// Só tem sentido pra ficha criada pelo mestre dentro de uma campanha
  /// (`campanhaId` preenchido e dono é o mestre): diz se ela abre na ficha
  /// de monstro (bestiário) do sistema ou na ficha de personagem completa.
  /// Fora desse caso — ficha de jogador comum — o valor é ignorado.
  ehMonstro     Boolean          @default(false)
  /// Organizacional só (decisão #134) — nunca é lido pela ficha nem muda
  /// nenhuma conta dela. Serve pra separar, nas listas do Hub, quem ainda
  /// está em jogo de quem não está mais.
  status        StatusPersonagem @default(ATIVO)
  /// Imagem própria do personagem — link externo (o Hub não hospeda
  /// arquivo, mesma solução já usada pro avatar da conta Google em
  /// `Usuario.avatarUrl`). `bannerUrl` é opcional mesmo quando há avatar.
  avatarUrl     String?
  bannerUrl     String?
  criadoEm      DateTime         @default(now())
  atualizadoEm  DateTime         @updatedAt

  sistema  Sistema   @relation(fields: [sistemaId], references: [id], onDelete: Restrict)
  dono     Usuario   @relation(fields: [donoId], references: [id], onDelete: Cascade)
  campanha Campanha? @relation(fields: [campanhaId], references: [id], onDelete: SetNull)

  grupoMembros         GrupoMembro[]
  /// Fichas das quais esta ficha é dona (companheiros/pets dela).
  companheirosOndeDono Companheiro[] @relation("DonoDoCompanheiro")
  /// Fichas para as quais esta ficha É o companheiro/pet.
  companheiroDe        Companheiro[] @relation("FichaComoCompanheiro")
  itens                Item[]
  veiculos             Veiculo[]

  @@index([donoId])
  @@index([sistemaId])
  @@index([campanhaId])
  @@map("personagens")
}

/// Um encontro jogado (marcado ou já rolado). Antes da decisão #135 este
/// modelo existia no schema, mas nenhuma rota nem tela usava ele.
model Sessao {
  id                  String   @id @default(uuid()) @db.Uuid
  campanhaId          String   @db.Uuid
  numero              Int
  /// Data e horário juntos — não existe campo "horário" separado, o
  /// horário já mora aqui dentro.
  data                DateTime
  resumoPublico       String?
  /// O que mudou de importante na campanha nesta sessão (ex.: "Fulano
  /// morreu", "grupo achou a Espada X") — público como `resumoPublico`,
  /// só separado pra ficar fácil de destacar na tela.
  mudancasImportantes String?
  /// Só o mestre da campanha lê este campo (decisão #13).
  notasMestre         String?
  criadoEm            DateTime @default(now())

  campanha  Campanha         @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  presencas SessaoPresenca[]

  @@unique([campanhaId, numero])
  @@map("sessoes")
}

/// Confirmação de presença de uma pessoa numa sessão (decisão #135) —
/// Vou/Talvez/Não vou. Depois que a sessão já rolou, a mesma linha também
/// serve de registro de quem esteve nela — não existe um segundo conceito
/// de "presença de verdade" separado da resposta dada.
model SessaoPresenca {
  id           String           @id @default(uuid()) @db.Uuid
  sessaoId     String           @db.Uuid
  usuarioId    String           @db.Uuid
  resposta     RespostaPresenca
  respondidoEm DateTime         @updatedAt

  sessao  Sessao  @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([sessaoId, usuarioId])
  @@index([usuarioId])
  @@map("sessoes_presencas")
}

// ---------------------------------------------------------------------------
// Comunicação (decisão #136)
// ---------------------------------------------------------------------------

/// Uma mensagem do chat simples da campanha. Sem edição nem exclusão — é
/// um histórico de conversa, não um documento pra lapidar.
model MensagemChat {
  id         String   @id @default(uuid()) @db.Uuid
  campanhaId String   @db.Uuid
  autorId    String   @db.Uuid
  texto      String
  criadoEm   DateTime @default(now())

  campanha Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  autor    Usuario  @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([campanhaId, criadoEm])
  @@map("mensagens_chat")
}

/// Aviso fixado no mural da campanha — só o mestre publica (é o quadro de
/// avisos da mesa, não um mural aberto). `fixado` decide se aparece no topo;
/// não fixado não significa escondido, só não prioritário.
model Aviso {
  id           String   @id @default(uuid()) @db.Uuid
  campanhaId   String   @db.Uuid
  autorId      String   @db.Uuid
  texto        String
  fixado       Boolean  @default(false)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  campanha Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  autor    Usuario  @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([campanhaId])
  @@map("avisos")
}

/// Enquete simples — o mestre pergunta, qualquer participante vota (uma vez,
/// pode trocar de ideia até a enquete fechar), o mestre encerra quando quiser
/// contar como definitivo. Sem prazo automático: fechar é sempre uma ação
/// explícita do mestre.
model Enquete {
  id         String   @id @default(uuid()) @db.Uuid
  campanhaId String   @db.Uuid
  autorId    String   @db.Uuid
  pergunta   String
  opcoes     String[]
  encerrada  Boolean  @default(false)
  criadoEm   DateTime @default(now())

  campanha Campanha      @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  autor    Usuario       @relation(fields: [autorId], references: [id], onDelete: Cascade)
  votos    EnqueteVoto[]

  @@index([campanhaId])
  @@map("enquetes")
}

/// Um voto — `opcaoIndex` aponta pra posição em `Enquete.opcoes` (enquete
/// simples não precisa de tabela de opções à parte). Uma linha por pessoa
/// por enquete; votar de novo troca a resposta em vez de somar outro voto.
model EnqueteVoto {
  id         String @id @default(uuid()) @db.Uuid
  enqueteId  String @db.Uuid
  usuarioId  String @db.Uuid
  opcaoIndex Int

  enquete Enquete @relation(fields: [enqueteId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([enqueteId, usuarioId])
  @@map("enquetes_votos")
}

/// Notificação interna simples — sem push nem e-mail (custo zero, decisão
/// #5), só uma lista dentro do próprio Hub. `texto` já vem pronto no momento
/// em que a notificação nasce, pra continuar fazendo sentido mesmo se a
/// sessão/aviso/enquete que a gerou for editado ou apagado depois.
model Notificacao {
  id         String          @id @default(uuid()) @db.Uuid
  usuarioId  String          @db.Uuid
  campanhaId String          @db.Uuid
  tipo       TipoNotificacao
  texto      String
  lida       Boolean         @default(false)
  criadoEm   DateTime        @default(now())

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  campanha Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  @@index([usuarioId, lida])
  @@map("notificacoes")
}

// ---------------------------------------------------------------------------
// Extras da campanha (decisão #140)
// ---------------------------------------------------------------------------

/// O tipo escolhe qual dos três campos de valor vale — só um deles é
/// preenchido por vez, os outros dois ficam nulos. `CONTADOR` e `NUMERO`
/// guardam os dois em `valorNumero`; a diferença é só de interface (contador
/// ganha botões de +1/-1 rápidos, número é um campo livre de digitar).
enum TipoCampoPersonalizado {
  TEXTO
  NUMERO
  CONTADOR
  BOOLEANO
}

/// Campo livre que o mestre cria pra guardar algo que a campanha precisa
/// acompanhar e não tem uma casa própria no Hub (clima da cena, ouro do
/// grupo, "modo hardcore ligado" etc.) — só o mestre cria/edita/apaga, mas
/// aparece pra qualquer participante, igual a identidade da campanha
/// (decisão #134), porque não guarda nada sensível.
model CampoPersonalizado {
  id            String                 @id @default(uuid()) @db.Uuid
  campanhaId    String                 @db.Uuid
  nome          String
  tipo          TipoCampoPersonalizado
  valorTexto    String?
  valorNumero   Float?
  valorBooleano Boolean?
  criadoEm      DateTime               @default(now())
  atualizadoEm  DateTime               @updatedAt

  campanha Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  @@index([campanhaId])
  @@map("campos_personalizados")
}

/// Marco que o mestre declara pra campanha ("o grupo derrotou o Dragão
/// Vermelho") — sem nenhuma relação com as conquistas de Campanha Livre
/// (aquelas vivem dentro do `dados` json da própria ficha daquele sistema,
/// e não devem ser mexidas). Só o mestre publica/edita/apaga; qualquer
/// participante lê, como um mural de "já rolou isso na nossa campanha".
model Conquista {
  id         String   @id @default(uuid()) @db.Uuid
  campanhaId String   @db.Uuid
  titulo     String
  descricao  String?
  criadoEm   DateTime @default(now())

  campanha Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  @@index([campanhaId])
  @@map("conquistas_campanha")
}

// ---------------------------------------------------------------------------
// Grupos, itens, companheiros e veículos (decisão #147)
// ---------------------------------------------------------------------------

/// Um grupo/equipe dentro da campanha (ex.: "esquadrão A", "os que ficaram na
/// cidade") — só organizacional, não muda regra de sistema nenhuma. Só o
/// mestre cria/renomeia/apaga e mexe nos membros.
model Grupo {
  id         String   @id @default(uuid()) @db.Uuid
  campanhaId String   @db.Uuid
  nome       String
  criadoEm   DateTime @default(now())

  campanha Campanha      @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  membros  GrupoMembro[]
  itens    Item[]

  @@index([campanhaId])
  @@map("grupos")
}

/// Uma ficha dentro de um grupo. Tabela simples de vínculo — a ficha em si
/// não sabe a quais grupos pertence, quem pergunta é sempre o grupo.
model GrupoMembro {
  id           String @id @default(uuid()) @db.Uuid
  grupoId      String @db.Uuid
  personagemId String @db.Uuid

  grupo      Grupo      @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  personagem Personagem @relation(fields: [personagemId], references: [id], onDelete: Cascade)

  @@unique([grupoId, personagemId])
  @@index([personagemId])
  @@map("grupos_membros")
}

/// Item genérico do Hub — de propósito fora do `dados` json de qualquer
/// ficha (decisão #17: cada sistema tem seu próprio formato de inventário,
/// isto aqui nunca tenta ser esse formato). Mora em exatamente um lugar por
/// vez: biblioteca pessoal de alguém, sem campanha nenhuma (`donoId`), com
/// uma ficha específica (`personagemId`), com o inventário de um grupo
/// (`grupoId`) ou no cofre da campanha (`campanhaId` sozinho, sem os
/// outros). "Transferir" um item é só trocar qual desses campos está
/// preenchido — nunca mexe no `dados` da ficha.
model Item {
  id           String   @id @default(uuid()) @db.Uuid
  nome         String
  descricao    String?
  quantidade   Int      @default(1)
  donoId       String?  @db.Uuid
  personagemId String?  @db.Uuid
  grupoId      String?  @db.Uuid
  campanhaId   String?  @db.Uuid
  criadoEm     DateTime @default(now())

  dono       Usuario?    @relation(fields: [donoId], references: [id], onDelete: Cascade)
  personagem Personagem? @relation(fields: [personagemId], references: [id], onDelete: Cascade)
  grupo      Grupo?      @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  campanha   Campanha?   @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  @@index([donoId])
  @@index([personagemId])
  @@index([grupoId])
  @@index([campanhaId])
  @@map("itens")
}

/// Vínculo entre duas fichas já existentes — uma é companheiro/pet da
/// outra. Não cria um tipo de ficha novo: o companheiro continua sendo uma
/// ficha comum (do mesmo sistema ou não), só marcada como ligada à ficha
/// dona.
model Companheiro {
  id            String @id @default(uuid()) @db.Uuid
  personagemId  String @db.Uuid
  companheiroId String @db.Uuid

  personagem  Personagem @relation("DonoDoCompanheiro", fields: [personagemId], references: [id], onDelete: Cascade)
  companheiro Personagem @relation("FichaComoCompanheiro", fields: [companheiroId], references: [id], onDelete: Cascade)

  @@unique([personagemId, companheiroId])
  @@index([companheiroId])
  @@map("companheiros")
}

/// Veículo genérico da campanha — deliberadamente simples, só pra
/// organizar "quem tem o quê e quanta gente cabe". Não duplica mecânica de
/// sistema nenhum (ex.: o Veículo Pessoal do Piloto de Fabula Ultima
/// continua vivendo só no `dados` da ficha daquele sistema, decisão #17).
model Veiculo {
  id         String   @id @default(uuid()) @db.Uuid
  campanhaId String   @db.Uuid
  donoId     String   @db.Uuid
  nome       String
  descricao  String?
  capacidade Int?
  criadoEm   DateTime @default(now())

  campanha Campanha   @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  dono     Personagem @relation(fields: [donoId], references: [id], onDelete: Cascade)

  @@index([campanhaId])
  @@index([donoId])
  @@map("veiculos")
}
